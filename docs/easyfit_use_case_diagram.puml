@startuml EasyFit_Use_Case_Diagram

!theme plain
skinparam backgroundColor #FFFFFF

    
    package "Coach Services" {
      usecase "Create Plans" as UC11
      usecase "Manage Templates" as UC12
      usecase "Customize Plans" as UC13
      usecase "Monitor Progress" as UC15
    }

    package "Communication" {
      usecase "Send/Receive Messages" as UC18
  ' Left side actors
  actor "Client" as Client #E8F5E8
  actor "Coach" as Coach #E8F0FF
    }
  ' Right side actor
  actor "Administrator" as Admin #FFE8E8
  }
  
  ' Right side: Admin with actor
  actor "Administrator" as Admin #FFE8E8
  
  rectangle "Admin Services" {
    package "Administration" {
      usecase "Manage Users" as UC22
      usecase "Approve Coaches" as UC23
      usecase "Monitor Platform" as UC24
      usecase "Generate Reports" as UC25
      usecase "Handle Support" as UC26
    }
  }
}

