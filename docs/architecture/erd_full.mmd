erDiagram
  %% ================ Users & Profiles ================
  CustomUser {
    int id PK
    string username
    string email
    string user_type
    boolean is_enabled
    boolean email_verified
    string staff_role
  }
  ClientProfile {
    int id PK
    int user_id FK
    int age
    string gender
    decimal height
    decimal weight
    decimal bmi
    decimal body_fat_percentage
    date last_measurement_date
  }
  CoachProfile {
    int id PK
    int user_id FK
    text bio
    decimal hourly_rate
    string approval_status
  }
  StaffProfile {
    int id PK
    int user_id FK
  }
  Certification {
    int id PK
    int coach_profile_id FK
    int verified_by_id FK
    string status
    datetime verified_at
  }

  CustomUser |o--|| ClientProfile : has
  CustomUser |o--|| CoachProfile : has
  CustomUser |o--|| StaffProfile : has
  CoachProfile ||--o{ Certification : has
  CustomUser |o--o{ Certification : has

  %% ================ Coach Plans & Templates ================
  ProductPlan {
    int id PK
    int coach_id FK
    string name
    text description
    string plan_type
    decimal price
    int duration_days
    date start_date
    date end_date
    string renewal_period
    string difficulty_level
    int workout_days_per_week
    int rest_days_per_week
    int meals_per_day
    int snacks_per_day
    decimal price_per_session
    int session_count
    boolean is_active
    datetime created_at
    datetime updated_at
  }
  PlanItem {
    int id PK
    int plan_id FK
    string name
    text description
    int order
  }
  PlanTemplate {
    int id PK
    int coach_id FK
    string name
    string template_type
    boolean is_public
    datetime created_at
    datetime updated_at
  }
  WorkoutTemplate {
    int id PK
    int template_id FK
    string name
    string workout_type
  }
  WorkoutTemplateImage {
    int id PK
  }
  WorkoutTemplateVideo {
    int id PK
  }
  ExerciseTemplate {
    int id PK
    int workout_template_id FK
    string exercise_name
    int order
  }
  MealTemplate {
    int id PK
    int template_id FK
    string meal_name
    string meal_type
    int calories
  }
  MealTemplateImage { int id PK }
  MealTemplateVideo { int id PK }
  MealTemplateIngredient {
    int id PK
    int meal_template_id FK
    string name
    decimal quantity
    string unit
  }

  CoachProfile ||--o{ ProductPlan : has
  ProductPlan ||--o{ PlanItem : has
  CoachProfile ||--o{ PlanTemplate : has
  PlanTemplate ||--o{ WorkoutTemplate : has
  WorkoutTemplate }o--o{ WorkoutTemplateImage : has
  WorkoutTemplate }o--o{ WorkoutTemplateVideo : has
  WorkoutTemplate ||--o{ ExerciseTemplate : has
  PlanTemplate ||--o{ MealTemplate : has
  MealTemplate }o--o{ MealTemplateImage : has
  MealTemplate }o--o{ MealTemplateVideo : has
  MealTemplate ||--o{ MealTemplateIngredient : has

  %% ================ Subscriptions & Requests ================
  PlanSubscription {
    int id PK
    int client_id FK
    int product_plan_id FK
    datetime subscribed_at
    string status
    boolean is_active
  }
  PlanRequest {
    int id PK
    int client_id FK
    int plan_id FK
    text message
    string status
    datetime created_at
    datetime updated_at
  }
  PlanCancellation {
    int id PK
    int subscription_id FK
    string cancellation_reason
    boolean refund_requested
    string refund_status
    datetime created_at
    datetime processed_at
  }

  CustomUser ||--o{ PlanSubscription : has
  ProductPlan ||--o{ PlanSubscription : has
  CustomUser ||--o{ PlanRequest : has
  ProductPlan ||--o{ PlanRequest : has
  PlanSubscription ||--o| PlanCancellation : has

  %% ================ Daily Entries ================
  PlanDay {
    int id PK
    int subscription_id FK
    int day_number
    date scheduled_date
    string completion_status
  }
  NutritionPlan {
    int id PK
    int plan_day_id FK
    string plan_name
    int plan_order
    int target_calories
  }
  MealPlan {
    int id PK
    int nutrition_plan_id FK
    string meal_type
    int meal_order
    string meal_name
  }
  MealIngredient {
    int id PK
    int meal_id FK
    string ingredient_name
    decimal quantity
    string unit
  }
  WorkoutPlan {
    int id PK
    int plan_day_id FK
    string session_name
    int session_order
    string workout_name
  }
  ExerciseBlock {
    int id PK
    int workout_plan_id FK
    string block_name
    string block_type
    int block_order
  }
  Exercise {
    int id PK
    int exercise_block_id FK
    string exercise_name
    int exercise_order
    int sets_count
  }

  PlanSubscription ||--o{ PlanDay : has
  PlanDay ||--o{ NutritionPlan : has
  NutritionPlan ||--o{ MealPlan : has
  MealPlan ||--o{ MealIngredient : has
  PlanDay ||--o{ WorkoutPlan : has
  WorkoutPlan ||--o{ ExerciseBlock : has
  ExerciseBlock ||--o{ Exercise : has

  %% ================ Dashboard & Analytics ================
  PlanProgress {
    int id PK
    int subscription_id FK
    int total_days
    int completed_days
    decimal completion_percentage
  }
  DailyProgressLog {
    int id PK
    int progress_id FK
    date date
    int meals_completed
    int workouts_completed
  }
  PlanMilestone {
    int id PK
    int subscription_id FK
    string milestone_type
    string title
    datetime achieved_at
  }
  WeeklyProgressSummary {
    int id PK
    int progress_id FK
    date week_start_date
    date week_end_date
    int days_completed
  }
  GoalTracking {
    int id PK
    int subscription_id FK
    string goal_type
    string title
    decimal target_value
    decimal current_value
  }

  PlanSubscription |o--|| PlanProgress : has
  PlanProgress ||--o{ DailyProgressLog : has
  PlanSubscription ||--o{ PlanMilestone : has
  PlanProgress ||--o{ WeeklyProgressSummary : has
  PlanSubscription ||--o{ GoalTracking : has

  %% ================ Messaging ================
  Conversation {
    int id PK
    int related_subscription_id FK
    string conversation_type
    string subject
    boolean is_active
    boolean is_archived
  }
  ConversationParticipant {
    int id PK
    int conversation_id FK
    int user_id FK
    boolean notifications_enabled
    boolean email_notifications
    boolean is_muted
  }
  Message {
    int id PK
    int conversation_id FK
    int sender_id FK
    text content
    string message_type
    datetime sent_at
    boolean is_edited
  }
  MessageReadReceipt {
    int id PK
    int message_id FK
    int user_id FK
    datetime read_at
  }

  PlanSubscription |o--o{ Conversation : has
  Conversation ||--o{ Message : has
  CustomUser ||--o{ Message : has
  CustomUser ||--o{ ConversationParticipant : has
  Conversation ||--o{ ConversationParticipant : has
  Message ||--o{ MessageReadReceipt : has
  CustomUser ||--o{ MessageReadReceipt : has

  %% ================ Ratings & Reviews ================
  PlanRating {
    int id PK
    int subscription_id FK
    int client_id FK
    int coach_id FK
    int overall_rating
    text review_content
    datetime created_at
  }
  RatingHelpfulness {
    int id PK
    int rating_id FK
    int user_id FK
    boolean is_helpful
    datetime voted_at
  }
  CoachRatingStats {
    int id PK
    int coach_id FK
    int total_ratings
    decimal average_overall_rating
  }

  PlanSubscription |o--|| PlanRating : has
  CustomUser ||--o{ PlanRating : has
  CoachProfile ||--o{ PlanRating : has
  PlanRating ||--o{ RatingHelpfulness : has
  CustomUser ||--o{ RatingHelpfulness : has
  CoachProfile ||--|| CoachRatingStats : has

  %% ================ Notifications ================
  PlanNotification {
    int id PK
    int subscription_id FK
    int user_id FK
    string notification_type
    string recipient_email
    string subject
    text email_content
    datetime sent_at
    boolean is_sent
    string delivery_status
    boolean is_read
    datetime read_at
    datetime created_at
    string plan_access_token
    datetime link_expires_at
    text additional_data
  }
  NotificationTemplate {
    int id PK
    string notification_type
    string subject_template
    text html_template
    text text_template
    boolean is_active
    datetime created_at
    datetime updated_at
  }
  NotificationPreference {
    int id PK
    int user_id FK
    boolean plan_created_email
    boolean daily_reminder_email
    string email_frequency
  }
  EmailQueue {
    int id PK
    int notification_id FK
    int priority
    string status
  }

  PlanSubscription |o--o{ PlanNotification : has
  CustomUser |o--o{ PlanNotification : has
  NotificationTemplate ||--o{ PlanNotification : has
  PlanNotification |o--|| EmailQueue : has
  CustomUser |o--|| NotificationPreference : has
